{
  "name": "grok-bot-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Two-way bridge between Grok Bot and local coding agents (Claude Code, Codex, any CLI). Agents ping your bot through webhook routines; your bot runs agents in the background and gets the result back.",
  "type": "module",
  "bin": {
    "gbb": "dist/cli.js",
    "grok-bot-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "grok",
    "grok-bot",
    "claude-code",
    "codex",
    "agents",
    "webhook",
    "bridge",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anup-a/grok-bot-bridge.git"
  }
}
